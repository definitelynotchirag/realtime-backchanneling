[Unit]
Description=Blue Machines LiveKit voice agent worker
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/realtime-voice-chat
EnvironmentFile=/home/ec2-user/realtime-voice-chat/.env
Environment=PATH=/home/ec2-user/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ec2-user/.local/bin/uv run blue-machines-agent start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
