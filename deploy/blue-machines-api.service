[Unit]
Description=Blue Machines FastAPI inspection API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/realtime-voice-chat
EnvironmentFile=/home/ec2-user/realtime-voice-chat/.env
Environment=PATH=/home/ec2-user/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ec2-user/.local/bin/uv run uvicorn blue_machines_baseline.api:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
