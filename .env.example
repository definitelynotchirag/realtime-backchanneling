# LiveKit Cloud or self-hosted server
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_AGENT_NAME=blue-machines-baseline

# Streaming STT for fair three-mode comparisons. LiveKit Inference uses the
# LiveKit credentials above and emits interim transcripts while the user speaks.
STT_PROVIDER=livekit_inference
LIVEKIT_STT_MODEL=google/gemini-3.5-transcribe-live

# Groq STT. Two options:
#   groq         - plain batch transcription (final transcripts only)
#   groq_interim - the same endpoint on a cadence, so interim transcripts arrive
#                  while the user speaks. Jev mode needs this.
GROQ_API_KEY=your-groq-api-key
GROQ_STT_MODEL=whisper-large-v3-turbo
# How much audio to buffer before asking for a partial transcript.
GROQ_INTERIM_INTERVAL_SECONDS=3.0

# Phase 2 experimental backchanneling
BACKCHANNEL_ENABLED=false
BACKCHANNEL_TEXT=mm-hmm
BACKCHANNEL_DELAY_SECONDS=1.4
BACKCHANNEL_COOLDOWN_SECONDS=4.0
# An acknowledgement still audible this soon before the user yields counts as an
# end-of-turn collision and is reported as `backchannel_collision`.
BACKCHANNEL_COLLISION_WINDOW_SECONDS=0.5

# End-of-turn signal for the policy:
#   livekit_inference - run the public streaming turn detector on user audio and
#                       feed the real probability to the policy (falls back
#                       automatically, and reports `eot_detector_unavailable`)
#   final_transcript  - binary fallback: treat a final transcript as end of turn
EOT_DETECTOR=livekit_inference

# Jev-assisted backchannel experiment (used by the Jev core integration)
TYPESAFE_API_KEY=your-typesafe-api-key
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=2.5
JEV_MIN_INTERVAL_SECONDS=0.75
JEV_APPROVAL_THRESHOLD=0.55
# How helpful a cue must look, and how likely the user must be NOT to expect an
# answer. The *_SEMANTIC pair applies to "uh-huh" / "I see" (they claim more than
# a neutral "mm-hmm"); lower them to hear more varied cues, raise them for silence.
JEV_HELPFUL_THRESHOLD=0.50
JEV_HELPFUL_THRESHOLD_SEMANTIC=0.52
JEV_EXPECTS_ANSWER_CEILING=0.60
JEV_EXPECTS_ANSWER_CEILING_SEMANTIC=0.50

# LLM provider: gemini (default), groq, or openrouter. Using groq for all three
# of STT/LLM/TTS keeps the whole agent on one key.
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Groq LLM (used when LLM_PROVIDER=groq)
GROQ_LLM_MODEL=openai/gpt-oss-120b

# Optional OpenRouter LLM endpoint (used only when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=stealth/union-alpha
# Comma-separated free fallbacks, tried in this order if the main model fails.
OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,liquid/lfm-2.5-2.6b:free

# TTS provider: livekit_inference (default), elevenlabs, gemini_tts, groq_tts, or
# openrouter_tts (uses the OpenRouter key; deepgram/flux-tts:free has a free tier)
TTS_PROVIDER=livekit_inference

# LiveKit Inference TTS (uses the LiveKit credentials above; no extra key)
LIVEKIT_TTS_MODEL=inworld/inworld-tts-2
LIVEKIT_TTS_VOICE=Ashley

# Optional direct ElevenLabs fallback/override
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5
ELEVENLABS_VOICE_ID=ODq5zmih8GrVes37Dizd

# Optional direct Gemini TTS (uses GEMINI_API_KEY; 24 kHz mono PCM)
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore

# OpenRouter speech (used when TTS_PROVIDER=openrouter_tts)
OPENROUTER_TTS_MODEL=deepgram/flux-tts:free
OPENROUTER_TTS_VOICE=flux-alexis-en

# Optional native Groq speech (Orpheus). Groq refuses synthesis until the
# account accepts the model's terms; the API answers with an explicit
# `model_terms_required` error until then. Accept them once at
# https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=autumn


# Scripted scenario clips used by `blue-machines-scenario`
SCENARIO_AUDIO_DIR=assets/scenarios

# Optional agent and local API settings
AGENT_INSTRUCTIONS=You are a friendly voice assistant. Reply in one short sentence of at most ten words.
EVENT_LOG_PATH=outputs/baseline-events.jsonl
BENCHMARK_EVENT_PATH=outputs/benchmark-replay-events.jsonl
BENCHMARK_REPORT_PATH=outputs/benchmark-report.json
API_HOST=127.0.0.1
API_PORT=8000
